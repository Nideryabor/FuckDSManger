.DS_Store
Thumbs.db

# —— 别把真实数据/产物扫进公开仓 ——
*.apk
*.db
*.db-shm
*.db-wal
*.bundle

# —— JVM 工具链的大件：本机 apt/下载装的，不入库 ——
#    目录与安装步骤见 tools/jvm/README.md（脚本会入库，jar 不会）
tools/jvm/lib/
tools/jvm/dex-tools/
tools/jvm/kotlinc/
tools/jvm/work/

# —— mod-src（真编译工程）——
# javac/d8 中间产物
mod-src/build/
# 编译出的 smali / apk
mod-src/out/
# 基础 APK：从手机拷进来的（*.apk 已在上面统一忽略）
mod-src/base/
# AOSP testkey：公开钥匙，但没必要入库（下载地址见 mod-src/README.md）
mod-src/pack/keys/
mod-src/pack/__pycache__/

# —— 私钥备份：绝对不入库 ——
# 私钥（fuckdsmanger.jks / .pk8 …）与给主人带走的副本
签名钥匙备份-2026-09-25/

# —— m3e-canvas（主人丢进来的 web 项目，不属于本仓）——
tmp/m3e-src/
tmp/m3e-canvas-main*.zip
tmp/m3e-canvas-*.patch

