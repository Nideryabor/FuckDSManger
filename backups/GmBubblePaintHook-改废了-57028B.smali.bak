# ★ 3.73.25（2026-10-31）气泡背景 · AppSurface 专用入口
#   AppSurface(Modifier, Shape, color, contentColor, content, composer, flags)
#   args[0]=Modifier  args[1]=Shape  args[2]=Long 颜色
#   ① 返回 void ⇒ 必须改 args[0]，不能用 setResult（3.73.22 白跑就是栽在这）
#   ② 颜色 0 = 透明外壳，跳过；Long.MIN_VALUE(Unspecified) 要处理（用户气泡本来无底色）
#   ③ 原语按签名找（GmPrims），不认名字（2.6.1 C/D → 2.7.1 B/C → 2.7.2 s/t）
# ★ 3.73.30 新增：surf() 的「说话」通道。
#   为什么要它：前几版 surf() 里 6 个 early-return **全是无声的** ⇒ 日志里啥也没有 ⇒
#   分不清「hook 没跑」「图开关关着」「原语没找到」「图不存在」。教训 96：跳过分支也要打日志。
#   用 logOnce（按 key 去重）⇒ 不会因为每帧重组把日志刷爆。
.method private static sLog(Ljava/lang/String;)V
    .registers 2

    :try_start_0
    invoke-static {p0, p0}, Lcom/nidyaber/fuckdsmanger/gm/GmUtil;->logOnce(Ljava/lang/String;Ljava/lang/String;)V
    :try_end_0
    .catchall {:try_start_0 .. :try_end_0} :catchall_0

    return-void

    :catchall_0
    move-exception v0

    return-void
.end method

