    #   `invoke-static {v3}, GmUtil->logOnce(String,String)` —— **只传了 1 个寄存器**，
    #   而 logOnce 要 2 个 ⇒ ART 校验器报
    #   `[0xDF] Rejecting invocation, expected 1 argument registers, method signature has 2 or more`
    #   ⇒ **整个 GmBubblePaintHook 类不加载** ⇒ x98.t / x98.s 的 hook 全部 FAIL
    #   ⇒ paint hook 从根上没挂上 ⇒ 用户气泡没背景。用 log（1 参）。
    invoke-static {v3, v3}, Lcom/nidyaber/fuckdsmanger/gm/GmUtil;->logOnce(Ljava/lang/String;Ljava/lang/String;)V

    # ═══════════════════════════════════════════════════════════════
    #  ★★★ 3.73.33 真凶（本项目最贵的一个 bug）★★★
    #
    #  ubMod(ClassLoader p0, Object p1, Object p2) 内部把参数当成：
    #      p1 = **Modifier**   （aput-object p1, arr, 0  ⇒ args[0]）
    #      p2 = **Shape**      （move-object v0, p2）
    #
    #  而老代码传的是 { v1(ClassLoader), v2(**null**), v4(args[2]=shape) }
    #  —— 因为上面 `const/4 v2, 0x0` 把 v2 清零之后就没再赋值！
    #  ⇒ p1 收到 null ⇒ GmPrims 校验 "args[0] instanceof Modifier" 必挂
    #  ⇒ backgroundBrush 返回 null ⇒ ub() 的 `if-eqz v3, :cond_a3` 直接跳过
    #  ⇒ **setResult 从来没执行过** ⇒ 气泡永远没图。
    #
    #  这就是 3.73.13~3.73.32 二十个版本「改了都没效果」的最终原因：
    #  不是门不对、不是 caller 不对、不是 shape 不对 —— 是**递进去的 Modifier 是 null**。
    #
    #  正确：{ ClassLoader, args[0]=Modifier, args[2]=Shape }
    #  （args 长度前面已判过 >= 3，这里取 args[0]/args[2] 安全）
    # ═══════════════════════════════════════════════════════════════
    const/4 v5, 0x2

    aget-object v5, v0, v5

    const/4 v4, 0x0

    aget-object v4, v0, v4

    invoke-static {v1, v4, v5}, Lcom/nidyaber/fuckdsmanger/gm/GmBubble;->ubMod(Ljava/lang/ClassLoader;Ljava/lang/Object;Ljava/lang/Object;)Ljava/lang/Object;

    move-result-object v3

    if-eqz v3, :cond_a3

    invoke-virtual {p0, v3}, Lde/robv/android/xposed/XC_MethodHook$MethodHookParam;->setResult(Ljava/lang/Object;)V
    :try_end_a3
    .catchall {:try_start_0 .. :try_end_a3} :catchall_a4

    :cond_a3
    return-void

    :catchall_a4
    move-exception v0

    invoke-static {v0}, Lcom/nidyaber/fuckdsmanger/gm/GmUtil;->logE(Ljava/lang/Throwable;)V

    return-void
.end method


