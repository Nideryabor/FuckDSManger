    /**
     * 按「当前态」摆封面与歌词。
     *
     * <p>常态：封面 {84×84} 靠左上，歌词在它右边（左缩进 = coverSide + 10）。
     * <br>聚焦：封面铺满整块 body，歌词叠在上面、不缩进。
     *
     * <p>★ 只在 body 的尺寸/态变了才重算 —— 由 OnLayoutChangeListener 驱动。
     */
    private void applyPlayLayout() {
        try {
            int bw = vBody.getWidth(), bh = vBody.getHeight();
            if (bw <= 0 || bh <= 0) return;

            FrameLayout.LayoutParams clp = (FrameLayout.LayoutParams) vCover.getLayoutParams();
            FrameLayout.LayoutParams llp = (FrameLayout.LayoutParams) vLyric.getLayoutParams();

            if (focusMode) {
                clp.width = FrameLayout.LayoutParams.MATCH_PARENT;
                clp.height = FrameLayout.LayoutParams.MATCH_PARENT;
                clp.leftMargin = 0;
                clp.topMargin = 0;
                llp.leftMargin = 0;
                vCover.setBackground(round(C_PANEL, 0));     /* 圆角交给卡片裁剪 */
            } else {
                int side = dp(COVER_SIDE);
                if (bh < side) side = Math.max(dp(36), bh);  /* 卡片压太矮就按比例缩 */
                clp.width = side;
                clp.height = side;
                clp.leftMargin = 0;
                clp.topMargin = 0;
                llp.leftMargin = side + dp(LRC_HALF);
                vCover.setBackground(round(C_PANEL, 10));
            }
            vCover.setLayoutParams(clp);
            vLyric.setLayoutParams(llp);
        } catch (Throwable t) {
            GmUtil.logFail("【GmMiniBar】摆版面失败", t);
        }
    }

