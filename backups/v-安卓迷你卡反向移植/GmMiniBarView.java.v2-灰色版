                t.setLayoutParams(new AbsListView.LayoutParams(
                        AbsListView.LayoutParams.MATCH_PARENT, dp(LRC_ROW_H)));
            }

            String s = (pos >= 0 && pos < lrcText.size()) ? lrcText.get(pos) : "";
            t.setText(s.length() == 0 ? "\u266A" : s);

            boolean cur = (pos == curLine);
