        d.setShape(GradientDrawable.OVAL);
        d.setColor(0xF2FFFFFF);
        int s = dp(14);
        d.setSize(s, s);
        return d;
    }

    /** 聚焦态的渐变暗膜（0.62 / 0.28 / 0.72），保证封面上的白字读得清。 */
    private Drawable scrimDrawable() {
