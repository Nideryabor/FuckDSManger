    /* ══════════════════════════════ ★ 布局核心：按 layoutT 插值 ══════════════════════════════
     *
     *  0 = 常态：
     *      封面 (PAD, bodyTop, 84, 84)
     *      歌词 (PAD+84+10, bodyTop, w-…, bodyH)
     *      进度条 (PAD, seekTop, w-2PAD, 22)
     *      按钮行 (PAD, btnTop, w-2PAD, 30)
     *      顶栏 三键可见，返回键隐藏，scrim alpha 0
     *
     *  1 = 聚焦：
     *      封面 (0, 0, w, h)          ← ★ 整卡，含标题栏区域
     *      歌词 (PAD, bodyTop, w-2PAD, h-PAD-bodyTop)
     *      进度条 / 按钮行 alpha 0
     *      顶栏 ♪ 和 ✕ 隐藏、返回键出现，scrim alpha 1
     */

    private void applyPlayLayout() {
        applyPlayLayout(layoutT);
    }

    private void applyPlayLayout(float t) {
        try {
            int w = getWidth(), h = getHeight();
            if (w <= 0 || h <= 0) return;
            if (t < 0f) t = 0f;
            if (t > 1f) t = 1f;

            final int P = dp(PAD);
            final int topH = dp(TOPBAR_H);
            final int bodyTop = P + topH + dp(BODY_GAP);
            final int btnH = dp(BTN_H);
            final int seekH = dp(SEEK_H);
            final int seekGap = dp(SEEK_GAP);

            final int btnTop = h - P - btnH;
            final int seekTop = btnTop - seekGap - seekH;
            final int bodyBottom = seekTop - seekGap;

            int bodyH = bodyBottom - bodyTop;
            if (bodyH < dp(40)) bodyH = dp(40);

            int side = dp(COVER_SIDE);
            if (side > bodyH) side = Math.max(dp(36), bodyH);

            /* ---- 封面：小方块 → 整卡 ---- */
            float cL = lerp(P, 0, t);
            float cT = lerp(bodyTop, 0, t);
            float cR = lerp(P + side, w, t);
            float cB = lerp(bodyTop + side, h, t);

            /* ---- 歌词：右侧窄条 → 铺满顶栏以下 ---- */
            float lL = lerp(P + side + dp(LRC_HALF), P, t);
            float lT = lerp(bodyTop, bodyTop, t);
            float lR = lerp(w - P, w - P, t);
            float lB = lerp(bodyTop + bodyH, h - P, t);

            setBounds(vCover, cL, cT, cR, cB);
            setBounds(vLyric, lL, lT, lR, lB);
            setBounds(vScrim, 0, 0, w, h);
            setBounds(vSeekRow, P, seekTop, w - P, seekTop + seekH);
            setBounds(vBtnRow, P, btnTop, w - P, btnTop + btnH);

            /* ---- 透明度 ---- */
            float inv = 1f - t;
            vSeekRow.setAlpha(inv);
            vBtnRow.setAlpha(inv);
            vScrim.setAlpha(t);
            vBtnPage.setAlpha(inv);
            vBtnClose.setAlpha(inv);
            vBtnBack.setAlpha(t);

            /* ---- 显示/隐藏 ----
             * ★★ alpha=0 的 View **照样吃触摸**！聚焦态底部那片必须 GONE，
             *    否则点封面下半部分会一直"切态"，永远做不了双击纯图。
             *    只在动画收尾才切 GONE（中途切会让动画闪）。 */
            boolean bottomGone = t > 0.98f;
            vSeekRow.setVisibility(bottomGone ? View.GONE : View.VISIBLE);
            vBtnRow.setVisibility(bottomGone ? View.GONE : View.VISIBLE);
            vBtnPage.setVisibility(bottomGone ? View.GONE : View.VISIBLE);
            vBtnClose.setVisibility(bottomGone ? View.GONE : View.VISIBLE);
            vBtnBack.setVisibility(t > 0.02f ? View.VISIBLE : View.GONE);

            /* ---- 封面圆角：10dp → 0（聚焦后交给卡片裁剪） ---- */
            try {
                vCover.invalidateOutline();
            } catch (Throwable ignore) {
            }

            /* ---- 标题压在图上时更亮 ---- */
            vTitle.setTextColor(blend(C_TXT, 0xFFFFFFFF, t));
        } catch (Throwable e) {
            GmUtil.logFail("【GmMiniBar】摆版面失败", e);
        }
    }

    /** 直接设矩形（用 setX/setY + layoutParams 宽高，不走 requestLayout 的位置部分）。 */
    private void setBounds(View v, float l, float t, float r, float b) {
        try {
            int iw = Math.max(1, Math.round(r - l));
            int ih = Math.max(1, Math.round(b - t));
            ViewGroup.LayoutParams gp = v.getLayoutParams();
            if (gp != null && (gp.width != iw || gp.height != ih)) {
                gp.width = iw;
                gp.height = ih;
                v.setLayoutParams(gp);
            }
            v.setX(l);
            v.setY(t);
        } catch (Throwable ignore) {
        }
    }

    private static float lerp(float a, float b, float t) {
        return a + (b - a) * t;
    }

    /** 两个 ARGB 之间按 t 混合（含 alpha）。 */
    private static int blend(int from, int to, float t) {
        int a = (int) lerp(Color.alpha(from), Color.alpha(to), t);
        int r = (int) lerp(Color.red(from), Color.red(to), t);
        int g = (int) lerp(Color.green(from), Color.green(to), t);
        int b = (int) lerp(Color.blue(from), Color.blue(to), t);
        return Color.argb(a, r, g, b);
    }

    /* ══════════════════════════════ ★ 液态玻璃 ══════════════════════════════
     *
     *  2026-10-25 主人：「毛玻璃还是丑不拉几的，试试看改成液态玻璃？」
     *
     *  从"抓卡片区域 + CPU box blur"改成"抓整窗缩略图 + GPU 模糊 + AGSL 折射"。
     *  复用工程里现成的 glass/ 那套（Haze 2.0 那条链，全是平台 API）：
     *
     *    glass/GmGlassPanel.drawAt()  → GmGlassGpu.draw()
     *                                    ├ RenderEffect.createBlurEffect()      GPU 模糊
     *                                    └ RenderEffect.createRuntimeShaderEffect()  AGSL 折射
     *
     *  ★★ 为什么"换位置"不再闪（v4 的核心改动）
     *    v3 的底图是**卡片区域**的截图 ⇒ 卡片一动就必须重抓 ⇒ 重抓要藏自己 ⇒ 闪。
     *    v4 的底图是**整窗 1/4 缩略图**，绘制时按 (ox,oy) 裁那一小块
     *    ⇒ 卡片移动只要传新的 ox/oy，背景自动跟着变，**一次都不用重抓** ⇒ 零闪。
     *    （这也是 GmGlassGpu 里 stretch=false 那条分支本来设计好的用法。）
     *
     *  ★ 防自反馈：抓整窗时卡片自己也在画面里 ⇒ 必须先把「卡片矩形」这块
     *    用**它外围一圈的像素**填掉（简易 inpaint），否则越抓越黑。
     *    这样抓图时**完全不用藏自己** ⇒ 又一个不闪的理由。
     */

    /** 底图降采样倍数（必须和 GmGlassBackdrop.SCALE 一致，GmGlassGpu 内部按它裁切）。 */
    private static final int GLASS_SCALE = 4;

    /** 底图最小间隔（ms）。 */
    private static final long GLASS_GAP_MS = 380L;

    /** 玻璃参数（主人 2026-10-25 定的"液态"观感）。 */
    private float glassBlurDp = 14f;      /* 模糊半径（dp） */
    private float glassDisp = 1.2f;       /* 色散（0~6，越大边缘彩虹越明显） */
    private float glassFadeAmt = 0.5f;    /* 边缘淡出强度 */
    /** 引擎：0=HAZE（Haze 2.0 折射）/ 1=CLOUDY / 2=RIPPLE。 */
    private int glassEngine = 0;

    /* ─────────────── 绘制 ─────────────── */

    @Override
    protected void onDraw(Canvas canvas) {
        // ① 玻璃（底图 + GPU 模糊 + 折射）；画不出就退回纯色
        boolean ok = false;
        if (!glassHideForCapture && glassBack != null && !glassBack.isRecycled()) {
            try {
                getLocationInWindow(glassLoc);
                int ox = glassLoc[0], oy = glassLoc[1];
                float radius = dp(CARD_R);
                float blurPx = glassBlurDp * getResources().getDisplayMetrics().density * 0.5f;
                float fadePx = dp(10);
                ok = com.nidyaber.fuckdsmanger.glass.GmGlassPanel.drawAt(
                        canvas, glassBack, ox, oy,
                        getWidth(), getHeight(), radius,
                        blurPx, /*tint*/ 0x22FFFFFF, glassDisp,
                        glassEngine, glassFadeAmt, fadePx);
            } catch (Throwable ignore) {
            }
        }
        if (!ok) {
            // 兜底：深蓝黑纯色（别是死灰）
            Paint p = sFallbackPaint;
            p.setColor(C_SOLID);
            canvas.drawRoundRect(new RectF(0, 0, getWidth(), getHeight()), dp(CARD_R), dp(CARD_R), p);
        }
        super.onDraw(canvas);
    }

    private static final Paint sFallbackPaint = new Paint(Paint.ANTI_ALIAS_FLAG);

    /* ─────────────── 抓底图（整窗 → 1/4 缩略图 → 填掉卡片自己 → 模糊） ─────────────── */

    /**
     * 抓一张整窗底图。
     *
     * <p>★ 不藏自己 —— 因为抓完会把「卡片矩形」这块用外围像素填掉（{@link #inpaintCard}）。
     * 藏自己才是 v3 闪的根源。
     *
     * @param force 绕过限流
     */
    void refreshBackdrop(final boolean force) {
        /* ★★ 看门狗（2026-10-25 真机踩的）：
         *   PixelCopy 的回调**有可能永远不回来** —— 而我们把 glassCapturing=false
         *   写在回调里 ⇒ 一旦不回来就**永久卡住**，之后每次都会在第一行 return，
         *   一条日志都没有（症状：液态玻璃底图永远是 null，界面只有兜底纯色）。
         *   GmGlassBackdrop 里也有一模一样的 STUCK_MS 看门狗，同一个坑。 */
        long now0 = System.currentTimeMillis();
        if (glassCapturing && glassCapturingAt > 0
                && now0 - glassCapturingAt > GLASS_STUCK_MS) {
            GmUtil.log("【GmMiniBar】抓底图卡了 " + (now0 - glassCapturingAt)
                    + "ms（看门狗强制解卡）");
            glassCapturing = false;
            glassCapturingAt = 0L;
            glassFail++;
        }
        if (glassCapturing) return;
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.N) return;   /* PixelCopy 要 24+ */
        /* ★ 已有底图就不再抓（除非 force）—— 整窗底图按坐标裁切，
         *   卡片怎么挪都不用重抓，这才是"零闪"的关键。 */
        if (!force && glassBack != null) return;
        if (glassFail >= 6) return;                                  /* 连续失败就别戳了 */
        if (getWidth() <= 0 || getHeight() <= 0) return;
        if (act == null || act.isFinishing()) return;

        /* ★★ 优先复用 GmGlassBackdrop 的现成底图 ——
         *   那套已经过真机验证（含看门狗、防自反馈），是整窗 1/{SCALE} 缩略图。
         *   拿不到再自己抓（见下面的 doCapture）。 */
        try {
            Bitmap shared = com.nidyaber.fuckdsmanger.glass.GmGlassBackdrop.get();
            if (shared != null && !shared.isRecycled()
                    && shared.getWidth() > 8 && shared.getHeight() > 8) {
                useBackdrop(shared.copy(Bitmap.Config.ARGB_8888, true), true);
                return;
            }
        } catch (Throwable ignore) {
        }

        long now = System.currentTimeMillis();
        if (!force && now - glassLastCapMs < GLASS_GAP_MS) return;
        /* 动画跑着的时候不抓（虽然不藏自己，但抓图本身要占一帧，动画中会卡） */
        if (layoutAnim != null && layoutAnim.isRunning()) return;
        glassLastCapMs = now;

        glassCapturing = true;
        glassCapturingAt = now;
        ui.post(new Runnable() {
            @Override
            public void run() {
                try {
                    doCapture();
                } catch (Throwable t) {
                    GmUtil.log("【GmMiniBar】抓底图异常：" + t);
                    glassCapturing = false;
                    glassFail++;
                }
            }
        });
    }

    /**
     * 换个底图（统一入口）。
     *
     * @param bmp     整窗 1/{SCALE} 缩略图（**会被接管/回收**）
     * @param foreign true = 这是从 GmGlassBackdrop 借来的副本，坐标原点是窗口 (0,0)；
     *                false = 自己抓的，需要按 decor 偏移换算（见 processCapture）
     */
    private void useBackdrop(Bitmap bmp, boolean foreign) {
        if (bmp == null || bmp.isRecycled()) return;
        try {
            if (!foreign) {
                /* 自己抓的那条路已经在 processCapture 里填过了 */
                return;
            }
            int[] loc = new int[2];
            getLocationInWindow(loc);
            int rl = loc[0] / GLASS_SCALE;
            int rt = loc[1] / GLASS_SCALE;
            int rr = rl + getWidth() / GLASS_SCALE;
            int rb = rt + getHeight() / GLASS_SCALE;
            inpaintRect(bmp, rl, rt, rr, rb);

            Bitmap old = glassBack;
            glassBack = bmp;
            glassBackW = bmp.getWidth();
            glassBackH = bmp.getHeight();
            if (old != null && old != bmp && !old.isRecycled()) old.recycle();
            glassFail = 0;
            glassCapturing = false;
            glassCapturingAt = 0L;
            GmUtil.log("【GmMiniBar】液态玻璃底图（借现成）" + glassBackW + "×" + glassBackH);
            invalidate();
        } catch (Throwable t) {
            try {
                bmp.recycle();
            } catch (Throwable ignore) {
            }
            glassFail++;
        }
    }

    private void doCapture() {
        final View decor;
        try {
            decor = act.getWindow() == null ? null : act.getWindow().getDecorView();
        } catch (Throwable t) {
            glassCapturing = false;
            return;
        }
        if (decor == null || decor.getWidth() <= 0 || decor.getHeight() <= 0) {
            GmUtil.log("【GmMiniBar】抓底图：decor 拿不到或尺寸 0");
            glassCapturing = false;
            glassCapturingAt = 0L;
            glassFail++;
            return;
        }

        final int dw = decor.getWidth(), dh = decor.getHeight();
        final int[] dloc = new int[2];
        try {
            decor.getLocationInWindow(dloc);
        } catch (Throwable ignore) {
        }

        final Bitmap full = Bitmap.createBitmap(dw, dh, Bitmap.Config.ARGB_8888);
        try {
            android.view.PixelCopy.request(act.getWindow(),
                    new Rect(dloc[0], dloc[1], dloc[0] + dw, dloc[1] + dh), full,
                    new android.view.PixelCopy.OnPixelCopyFinishedListener() {
                        @Override
                        public void onPixelCopyFinished(int result) {
                            if (result != android.view.PixelCopy.SUCCESS) {
                                GmUtil.log("【GmMiniBar】抓底图失败 code=" + result
                                        + "（第 " + (glassFail + 1) + " 次）");
                                try {
                                    full.recycle();
                                } catch (Throwable ignore) {
                                }
                                glassCapturing = false;
                                glassCapturingAt = 0L;
                                glassFail++;
                                return;
                            }
                            processCapture(full, dloc);
                        }
                    }, ui);
        } catch (Throwable t) {
            GmUtil.log("【GmMiniBar】PixelCopy 抛了：" + t);
            try {
                full.recycle();
            } catch (Throwable ignore) {
            }
            glassCapturing = false;
            glassFail++;
        }
    }

    /**
     * 处理刚抓到的整窗图：缩 1/{SCALE} → **填掉卡片自己** → 存成底图。
     *
     * <p>★ 不预先模糊 —— {@code GmGlassGpu} 内部就挂了
     * {@code RenderEffect.createBlurEffect}（GPU 模糊），传原图更清晰。
     * 预先 CPU 模糊反而会糊两遍，还慢。
     */
    private void processCapture(Bitmap full, int[] dloc) {
        try {
            final int dw = full.getWidth(), dh = full.getHeight();
            int sw = Math.max(2, dw / GLASS_SCALE), sh = Math.max(2, dh / GLASS_SCALE);
            Bitmap small = Bitmap.createScaledBitmap(full, sw, sh, true);
            if (small != full) full.recycle();

            /* ★ 把「卡片矩形」这块用外围像素填掉 —— 否则抓到的底图里含卡片自己
             *   ⇒ 玻璃再叠上去 ⇒ 越抓越黑的自反馈。填掉就完全不用藏自己。 */
            int[] loc = new int[2];
            getLocationInWindow(loc);
            int rl = (loc[0] - dloc[0]) / GLASS_SCALE;
            int rt = (loc[1] - dloc[1]) / GLASS_SCALE;
            int rr = rl + getWidth() / GLASS_SCALE;
            int rb = rt + getHeight() / GLASS_SCALE;
            inpaintRect(small, rl, rt, rr, rb);

            // 换上
            Bitmap old = glassBack;
            glassBack = small;
            glassBackW = sw;
            glassBackH = sh;
            if (old != null && old != small && !old.isRecycled()) old.recycle();
            glassFail = 0;
            glassCapturing = false;
            glassCapturingAt = 0L;
            GmUtil.log("【GmMiniBar】液态玻璃底图 " + sw + "×" + sh
                    + "（卡片区域已填掉 " + rl + "," + rt + "→" + rr + "," + rb + "）");
            invalidate();
        } catch (Throwable t) {
            GmUtil.log("【GmMiniBar】处理底图失败：" + t);
            glassCapturing = false;
            glassCapturingAt = 0L;
            glassFail++;
        }
    }

    /**
     * 把矩形区域用「它外围一圈的像素」填掉（简易 inpaint）。
     *
     * <p>做法：矩形内每个像素按<b>离哪条边最近</b>，就取那条边外面的像素
     * （同行/同列往外推同样的距离）。既快（O(面积)）又比"平均成纯色"自然，
     * 而且模糊 + 折射之后完全看不出来。
     */
    private static void inpaintRect(Bitmap bmp, int rl, int rt, int rr, int rb) {
        try {
            final int w = bmp.getWidth(), h = bmp.getHeight();
            if (rl < 0) rl = 0;
            if (rt < 0) rt = 0;
            if (rr > w) rr = w;
            if (rb > h) rb = h;
            // 四周至少留 1px 可采（不留就直接放弃填充，别崩）
            if (rl < 1 || rt < 1 || rr >= w - 1 || rb >= h - 1) return;
            if (rr - rl < 2 || rb - rt < 2) return;

            int[] pix = new int[w * h];
            bmp.getPixels(pix, 0, w, 0, 0, w, h);
            int[] src = pix.clone();      /* 从原图读、往新图写（避免环状依赖） */

            for (int y = rt; y < rb; y++) {
                int row = y * w;
                for (int x = rl; x < rr; x++) {
                    int dl = x - rl, dr = rr - 1 - x;
                    int dt = y - rt, db = rb - 1 - y;
                    int m = dl, mode = 0;
                    if (dt < m) { m = dt; mode = 1; }
                    if (dr < m) { m = dr; mode = 2; }
                    if (db < m) { m = db; mode = 3; }
                    int sx = x, sy = y;
                    switch (mode) {
                        case 0:  sx = rl - 1 - m;  break;   /* 左 */
                        case 1:  sy = rt - 1 - m;  break;   /* 上 */
                        case 2:  sx = rr + m;      break;   /* 右 */
                        default: sy = rb + m;      break;   /* 下 */
                    }
                    if (sx < 0) sx = 0;
                    if (sx >= w) sx = w - 1;
                    if (sy < 0) sy = 0;
                    if (sy >= h) sy = h - 1;
                    pix[row + x] = src[sy * w + sx];
                }
            }
            bmp.setPixels(pix, 0, w, 0, 0, w, h);
        } catch (Throwable ignore) {
        }
    }

